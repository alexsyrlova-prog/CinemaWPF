<Window x:Class="KinoWPF.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KinoWPF"
        mc:Ignorable="d"
        Title="Управление проектами" Height="850" Width="600" WindowStartupLocation="CenterScreen">
    <!-- ScrollViewer на случай, если форма на маленьком экране не влезет по высоте -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Главный контейнер складывает блоки строго сверху вниз -->
        <StackPanel Margin="15">

            <!-- БЛОК ФИЛЬТРАЦИИ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Фильтр по статусу: " VerticalAlignment="Center"/>
                <ComboBox x:Name="cbFilterStatus" Width="180" Margin="10,0,0,0" SelectionChanged="CbFilterStatus_SelectionChanged">
                    <ComboBoxItem Content="Все статусы"/>
                    <ComboBoxItem Content="В разработке"/>
                    <ComboBoxItem Content="На паузе"/>
                    <ComboBoxItem Content="Завершен"/>
                </ComboBox>
            </StackPanel>

            <!-- ТАБЛИЦА ПРОЕКТОВ (Высота ограничена, чтобы оставалось место под форму) -->
            <DataGrid x:Name="dgProjects" Height="220" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*"/>
                    <DataGridTextColumn Header="Бюджет" Binding="{Binding Budget, StringFormat={}{0:N0}}" Width="Auto"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- КНОПКИ УПРАВЛЕНИЯ СПИСКОМ -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Width="100" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- ФОРМА ВВОДА (По умолчанию скрыта) -->
            <StackPanel x:Name="panelForm" Visibility="Visible">
                <TextBlock x:Name="lblFormTitle" Text="Данные проекта" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Название проекта *"/>
                <TextBox x:Name="txtName" Margin="0,2,0,10"/>

                <TextBlock Text="Жанр"/>
                <TextBox x:Name="txtGenre" Margin="0,2,0,10"/>

                <TextBlock Text="Бюджет *"/>
                <TextBox x:Name="txtBudget" Margin="0,2,0,10"/>

                <TextBlock Text="Дата начала *"/>
                <DatePicker x:Name="dpStart" Margin="0,2,0,10"/>

                <TextBlock Text="Дата окончания *"/>
                <DatePicker x:Name="dpEnd" Margin="0,2,0,10"/>

                <TextBlock Text="Статус *"/>
                <!-- Выпадающий список для статуса на форме -->
                <ComboBox x:Name="cbFormStatus" Margin="0,2,0,10">
                    <ComboBoxItem Content="В разработке"/>
                    <ComboBoxItem Content="На паузе"/>
                    <ComboBoxItem Content="Завершен"/>
                </ComboBox>

                <TextBlock Text="Целевая аудитория"/>
                <TextBox x:Name="txtAudience" Margin="0,2,0,15"/>

                <!-- Поле отображения ошибок валидации -->
                <TextBlock x:Name="lblValidationError" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Visible"/>

                <!-- КНОПКИ ФОРМЫ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btnCancel" Content="Отмена" Width="80" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
