<Window x:Class="KinoWPF.AreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KinoWPF"
        mc:Ignorable="d"
        Title="Управление площадками" Height="614" Width="550" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,-6">
        <!-- Главный линейный контейнер -->
        <StackPanel Margin="15" Height="560">

            <!-- ТАБЛИЦА ПЛОЩАДОК -->
            <DataGrid x:Name="dgVenues" Height="220" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="Тип площадки" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Цена / день" Binding="{Binding RentalPrice, StringFormat={}{0:N0}}" Width="Auto"/>
                    <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- КНОПКИ ДЛЯ ТАБЛИЦЫ -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Width="100" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- ФОРМА ВВОДА (По умолчанию скрыта) -->
            <StackPanel x:Name="panelForm" Visibility="Visible">
                <TextBlock x:Name="lblFormTitle" Text="Данные площадки" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Адрес площадки *"/>
                <TextBox x:Name="txtAddress" Margin="0,2,0,10"/>

                <TextBlock Text="Тип площадки (например: Студия, Театр, Открытая)"/>
                <TextBox x:Name="txtType" Margin="0,2,0,10"/>

                <TextBlock Text="Стоимость аренды в день *"/>
                <TextBox x:Name="txtPrice" Margin="0,2,0,10"/>

                <TextBlock Text="Вместимость (чел.) *"/>
                <TextBox x:Name="txtCapacity" Margin="0,2,0,15"/>

                <!-- Блок для отображения ошибок -->
                <TextBlock x:Name="lblValidationError" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Visible"/>

                <!-- КНОПКИ ФОРМЫ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btnCancel" Content="Отмена" Width="80" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
