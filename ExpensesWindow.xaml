<Window x:Class="KinoWPF.ExpensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KinoWPF"
        mc:Ignorable="d"
        Title="Учет затрат" Height="800" Width="600" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Главный линейный контейнер -->
        <StackPanel Margin="15">

            <!-- БЛОК ФИЛЬТРАЦИИ -->
            <TextBlock Text="Фильтрация затрат" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Проект:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbFilterProject" Width="140" Margin="5,0,15,0" SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Тип затраты:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFilterType" Width="140" Margin="5,0,15,0" TextChanged="Filter_Changed"/>

                <Button x:Name="btnClearFilter" Content="Сбросить" Width="80" Click="BtnClearFilter_Click"/>
            </StackPanel>

            <!-- ТАБЛИЦА ЗАТРАТ -->
            <DataGrid x:Name="dgExpenses" Height="220" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="Тип затраты" Binding="{Binding ExpenseType}" Width="*"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="Auto"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- КНОПКИ ДЛЯ ТАБЛИЦЫ -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                <Button x:Name="btnAdd" Content="Добавить затрату" Width="120" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Width="110" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- ФОРМА ВВОДА (По умолчанию скрыта) -->
            <StackPanel x:Name="panelForm" Visibility="Visible">
                <TextBlock x:Name="lblFormTitle" Text="Параметры затраты" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Проект *"/>
                <ComboBox x:Name="cbFormProject" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Тип затраты (например: Аренда, Оборудование, Гонорар) *"/>
                <TextBox x:Name="txtFormType" Margin="0,2,0,10"/>

                <TextBlock Text="Сумма *"/>
                <TextBox x:Name="txtFormAmount" Margin="0,2,0,10"/>

                <TextBlock Text="Дата *"/>
                <DatePicker x:Name="dpFormDate" Margin="0,2,0,15"/>

                <!-- Блок вывода ошибок валидации -->
                <TextBlock x:Name="lblValidationError" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Visible"/>

                <!-- КНОПКИ ФОРМЫ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btnCancel" Content="Отмена" Width="80" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
