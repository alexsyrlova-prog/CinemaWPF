<Window x:Class="KinoWPF.FilmCrewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KinoWPF"
        mc:Ignorable="d"
        Title="Состав съёмочной группы" Height="700" Width="600" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Главный контейнер складывает блоки сверху вниз -->
        <StackPanel Margin="15">

            <TextBlock Text="Распределение сотрудников по проектам" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <!-- ТАБЛИЦА СЪЁМОЧНОЙ ГРУППЫ -->
            <DataGrid x:Name="dgCrew" Height="220" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="*"/>
                    <DataGridTextColumn Header="Роль в проекте" Binding="{Binding Role}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- КНОПКИ ДЛЯ ТАБЛИЦЫ -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Width="100" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- ФОРМА ВВОДА (По умолчанию скрыта) -->
            <StackPanel x:Name="panelForm" Visibility="Visible">
                <TextBlock x:Name="lblFormTitle" Text="Назначение роли" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Выберите проект *"/>
                <!-- Выпадающий список проектов -->
                <ComboBox x:Name="cbProjects" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Выберите сотрудника *"/>
                <!-- Выпадающий список сотрудников -->
                <ComboBox x:Name="cbEmployees" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Роль в проекте (например: Режиссер, Оператор, Актер) *"/>
                <TextBox x:Name="txtRole" Margin="0,2,0,15"/>

                <!-- Блок для отображения ошибок валидации -->
                <TextBlock x:Name="lblValidationError" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Visible"/>

                <!-- КНОПКИ ФОРМЫ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btnCancel" Content="Отмена" Width="80" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
