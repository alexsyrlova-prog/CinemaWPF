<Window x:Class="KinoWPF.EmployesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KinoWPF"
        mc:Ignorable="d"
        Title="Сотрудники" Height="350" Width="600" WindowStartupLocation="CenterScreen">
    <!-- Один главный контейнер, который просто складывает элементы сверху вниз -->
    <StackPanel Margin="15">

        <!-- БЛОК ПОИСКА -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск по фамилии: " VerticalAlignment="Center"/>
            <TextBox x:Name="txtSearch" Width="200" Margin="10,0,0,0" TextChanged="TxtSearch_TextChanged"/>
        </StackPanel>

        <!-- ТАБЛИЦА (DataGrid автоматом займет место по контенту) -->
        <DataGrid x:Name="dgEmployees" Height="200" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Специализация" Binding="{Binding Specialization}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Ставка" Binding="{Binding Rate}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- КНОПКИ УПРАВЛЕНИЯ ТАБЛИЦЕЙ -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
            <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="0,0,10,0"/>
            <Button x:Name="btnEdit" Content="Редактировать" Width="100" Margin="0,0,10,0"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="100"/>
        </StackPanel>
    </StackPanel>
</Window>
